{
  "name": "@nine-co/grideditor-core",
  "license": "GPL-3.0",
  "version": "0.3.1",
  "description": "Block style post editor.",
  "author": "George",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src package --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc",
    "build-package": "tsup package/index.tsx --format esm --dts --clean",
    "prepublishOnly": "npm run build-package",
    "release": "npm run build-package && changeset publish"
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^3.0.1",
    "@types/react-modal": "^3.13.1",
    "classnames": "^2.3.2",
    "heic2any": "^0.0.4",
    "react": ">=19",
    "react-dom": ">=19",
    "react-intl": ">=7",
    "react-modal": "^3.16.1",
    "use-debounce": "^10.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.4.14",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "postcss-nesting": "^14.0.1",
    "prettier": "^3.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.104.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nine-Co-Group/nine-grideditor.git"
  }
}
